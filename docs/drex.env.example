# civ-drex configuration. Copy outside the repository, e.g.:
#   mkdir -p ~/.config/civ-drex && cp docs/drex.env.example ~/.config/civ-drex/drex.env
#   chmod 600 ~/.config/civ-drex/drex.env
# Process environment variables override values in this file.

# Required. Create a key at https://drex.nace.ai (Drex keys start with nace_sk_).
DREX_API_KEY=nace_sk_REPLACE_ME

# Optional (defaults shown).
DREX_BASE_URL=https://drex.nace.ai
DREX_MODEL=drex-latest
DREX_TIMEOUT_S=15
DREX_MAX_RETRIES=2
DREX_MAX_OPTIONS=255
